# Token donné par @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=123456789:AAAA...

# Clé API OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Modèle utilisé (gpt-5-mini = bon rapport qualité/prix, gpt-5 = plus intelligent)
OPENAI_MODEL=gpt-5-mini

# Nom du personnage
BOT_NAME=Jarvis

# Fuseau horaire par défaut si celui de l'utilisateur n'est pas reconnu
DEFAULT_TIMEZONE=Europe/Paris

# Optionnel : liste d'ID Telegram autorisés (séparés par des virgules).
# Laisse vide pour autoriser tout le monde (attention à ta facture OpenAI).
# Ton ID : envoie un message à @userinfobot
ALLOWED_USER_IDS=

# Fichier de base de données SQLite
DATABASE_PATH=selfdevbot.db
