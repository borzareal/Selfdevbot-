# Token donné par @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=123456789:AAAA...

# Clé API Gemini, gratuite : https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OU clé OpenAI (payante) : https://platform.openai.com/api-keys
# Si GEMINI_API_KEY est remplie, c'est Gemini qui est utilisé.
OPENAI_API_KEY=

# Optionnel : modèle utilisé. Par défaut gemini-flash-latest (Gemini) ou gpt-5-mini (OpenAI).
AI_MODEL=

# Optionnel : modèles de secours si le premier est surchargé (séparés par des virgules).
# Par défaut avec Gemini : gemini-flash-lite-latest,gemini-2.5-flash
AI_FALLBACK_MODELS=

# Optionnel : vocaux ElevenLabs (https://elevenlabs.io/app/settings/api-keys).
# Finis un message par "ans=voc" et le bot te répond en vocal.
ELEVENLABS_API_KEY=
# Voix (ID visible dans la bibliothèque de voix). Par défaut : George, voix posée façon Alfred.
ELEVENLABS_VOICE_ID=
# eleven_multilingual_v2 (meilleure qualité) ou eleven_flash_v2_5 (2x moins de crédits)
ELEVENLABS_MODEL=

# Nom du personnage
BOT_NAME=Jarvis

# Fuseau horaire par défaut si celui de l'utilisateur n'est pas reconnu
DEFAULT_TIMEZONE=Europe/Paris

# Optionnel : liste d'ID Telegram autorisés (séparés par des virgules).
# Laisse vide pour autoriser tout le monde (attention à ta facture OpenAI).
# Ton ID : envoie un message à @userinfobot
ALLOWED_USER_IDS=

# Fichier de base de données SQLite
DATABASE_PATH=selfdevbot.db
